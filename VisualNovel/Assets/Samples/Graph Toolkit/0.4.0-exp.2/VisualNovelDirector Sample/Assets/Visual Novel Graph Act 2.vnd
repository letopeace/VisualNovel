      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "(\u0422\u0430\u043A\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
          \u043F\u0443\u0442\u0438 \u043B\u0438\u0441\u0435\u043D\u043A\u0430 \u0438
          \u043E\u043B\u0435\u043D\u044F \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C.
          \u041B\u0438\u0441\u0435\u043D\u043E\u043A \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
          \u0432 \u0441\u0432\u043E\u0435\u0439 \u043F\u0440\u0435\u0436\u043D\u0435\u0439
          \u0441\u0442\u0430\u0435 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
          \u0443\u043A\u0440\u0435\u043F\u0438\u0432\u0448\u0438\u0441\u044C \u0432
          \u0442\u043E\u043C \u0447\u0442\u043E \u0431\u0435\u0437 \u0441\u0435\u043C\u044C\u0438
          \u0432\u044B\u0436\u0438\u0442\u044C \u043D\u0435\u043B\u044C\u0437\u044F.
          \u0410 \u043E\u043B\u0435\u043D\u044C \u0443\u0431\u0435\u0436\u0430\u043B
          \u0432 \u043B\u0435\u0441, \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430
          \u043B\u0438\u0448\u0438\u0432\u0448\u0438\u0441\u044C \u0434\u043E\u0432\u0435\u0440\u0438\u044F
          \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438
          \u0445\u043E\u0442\u044C \u0441 \u043A\u0435\u043C \u0442\u043E \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F.)"
