      data:
        m_Value: "(\u042D\u0442\u0438 \u044D\u043C\u043E\u0446\u0438\u0438. \u0422\u0435\u043F\u043B\u043E\u0442\u0430
          \u0438 \u0441\u0438\u043B\u044C\u043D\u0430\u044F \u043B\u044E\u0431\u043E\u0432\u044C.
          \u0412 \u0436\u0438\u0432\u043E\u0442\u0435 \u0431\u0443\u0434\u0442\u043E
