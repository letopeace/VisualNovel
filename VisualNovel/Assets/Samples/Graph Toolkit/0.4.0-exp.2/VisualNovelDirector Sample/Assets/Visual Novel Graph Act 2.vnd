      type: {class: 'Constant`1[[System.String, mscorlib]]', ns: Unity.GraphToolkit.Editor, asm: Unity.GraphToolkit.Internal.Editor}
      data:
        m_Value: "(\u041D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0432
          \u0432\u0441\u0435\u0439 \u0431\u043E\u043B\u0438 \u0438 \u0431\u0435\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
          \u043B\u0438\u0441\u0435\u043D\u043A\u0430, \u043E\u043B\u0435\u043D\u044C
          \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F \u0432 \u0431\u0435\u0433.
          \u041E\u043D \u0431\u0435\u0436\u0430\u043B, \u0445\u043E\u0442\u044F \u0435\u0433\u043E
          \u0440\u0430\u043D\u044B \u0431\u044B\u043B\u0438 \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u044B.
          \u041E\u043D \u0431\u0435\u0436\u0430\u043B, \u0445\u043E\u0442\u044F \u0435\u0433\u043E
          \u043A\u043E\u0441\u0442\u0438 \u0431\u044B\u043B\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u044B.
          \u041E\u043D \u0431\u0435\u0436\u0430\u043B, \u0445\u043E\u0442\u044F \u043B\u0438\u0441\u0435\u043D\u043E\u043A
          \u043A\u0440\u0438\u0447\u0430\u043B\u0430 \u0435\u043C\u0443 \u0432\u0441\u043B\u0435\u0434.)"
